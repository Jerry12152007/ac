<Window x:Class="ACLocalTrafficStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AC Local Traffic Studio" Height="780" Width="1180"
        MinHeight="650" MinWidth="950" Background="#151A22" Foreground="#F3F5F7"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="AC LOCAL TRAFFIC STUDIO" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="本地交通工作室 · 第一階段：環境與資源掃描" Foreground="#AAB4C2" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Background="#26372F" CornerRadius="12" Padding="12,7" HorizontalAlignment="Right">
                <TextBlock Text="LOCAL ONLY · READ ONLY" Foreground="#73E0AE" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="#202631" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Assetto Corsa 遊戲目錄" FontWeight="SemiBold"/>
                    <TextBox x:Name="RootBox" Margin="0,7,12,0" Height="34" VerticalContentAlignment="Center"
                             Background="#111720" Foreground="White" BorderBrush="#465263" Padding="8"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BrowseButton" Content="選擇資料夾" Width="110" Height="36" Margin="0,25,8,0"
                        Click="Browse_Click" Background="#354153" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="2" x:Name="ScanButton" Content="開始掃描" Width="110" Height="36" Margin="0,25,0,0"
                        Click="Scan_Click" Background="#36C58A" Foreground="#102018" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="#202631" Foreground="#F3F5F7" BorderBrush="#394352">
            <TabItem Header="本地車輛">
                <DataGrid x:Name="CarsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                          AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="資料夾" Binding="{Binding Folder}" Width="170"/>
                        <DataGridTextColumn Header="車輛名稱" Binding="{Binding DisplayName}" Width="220"/>
                        <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="120"/>
                        <DataGridTextColumn Header="初步檢查" Binding="{Binding Status}" Width="220"/>
                        <DataGridTextColumn Header="備註" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="地圖與 Layout">
                <DataGrid x:Name="TracksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                          AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="地圖資料夾" Binding="{Binding Folder}" Width="200"/>
                        <DataGridTextColumn Header="Layout" Binding="{Binding Layout}" Width="220"/>
                        <DataGridTextColumn Header="顯示名稱" Binding="{Binding DisplayName}" Width="250"/>
                        <DataGridTextColumn Header="AI 路線初檢" Binding="{Binding AiStatus}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="掃描報告">
                <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="#202631" Foreground="#DCE4ED"
                         BorderThickness="0" Padding="14"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="準備就緒。掃描功能只讀取檔案，不會修改遊戲。" Foreground="#AAB4C2" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="V1.0.0 · Phase 1" Foreground="#738093"/>
        </DockPanel>
    </Grid>
</Window>
