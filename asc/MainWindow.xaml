<Window x:Class="ACLocalTrafficStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AC Local Traffic Studio — 神力科莎本地 AI 交通管理工作室" Height="900" Width="1320"
        MinHeight="700" MinWidth="1080" Background="#151A22" Foreground="#F3F5F7"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="AC LOCAL TRAFFIC STUDIO" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="神力科莎本地 AI 交通管理工作室 · Phase 2：交通預設檔 / AI 行為 / 動態密度 / 交通計畫" Foreground="#AAB4C2" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Background="#26372F" CornerRadius="12" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="LOCAL ONLY · OFFLINE · READ-ONLY" Foreground="#73E0AE" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="#202631" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Assetto Corsa 遊戲目錄" FontWeight="SemiBold"/>
                    <TextBox x:Name="RootBox" Margin="0,7,12,0" Height="34" VerticalContentAlignment="Center"
                             Background="#111720" Foreground="White" BorderBrush="#465263" Padding="8"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BrowseButton" Content="選擇資料夾" Width="110" Height="36" Margin="0,25,8,0"
                        Click="Browse_Click" Background="#354153" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="2" x:Name="ScanButton" Content="開始掃描" Width="110" Height="36" Margin="0,25,0,0"
                        Click="Scan_Click" Background="#36C58A" Foreground="#102018" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="#202631" Foreground="#F3F5F7" BorderBrush="#394352">

            <TabItem Header="環境總覽">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <WrapPanel Margin="0,0,0,10">
                            <Border x:Name="ShutokoBadge" Background="#1E3A2E" CornerRadius="10" Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="🛣️ 已找到 Shutoko 高速公路地圖" Foreground="#73E0AE" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="NordschleifeBadge" Background="#3A2E1E" CornerRadius="10" Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="🏁 已找到 Nordschleife 賽道日地圖" Foreground="#E0C073" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="CspBadge" Background="#1E2E3A" CornerRadius="10" Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="🧩 Custom Shaders Patch 已安裝" Foreground="#7EC8E0" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="CmBadge" Background="#1E2E3A" CornerRadius="10" Padding="10,6" Visibility="Collapsed">
                                <TextBlock Text="🧰 Content Manager 已安裝" Foreground="#7EC8E0" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                        <TextBox x:Name="EnvBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#171D26" Foreground="#DCE4ED" BorderBrush="#394352" Padding="12" Height="430"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="本地車輛">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CarsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionChanged="CarsGrid_SelectionChanged"
                              Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                              AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="資料夾" Binding="{Binding Folder}" Width="150"/>
                            <DataGridTextColumn Header="車輛名稱" Binding="{Binding DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="110"/>
                            <DataGridTextColumn Header="級別" Binding="{Binding ClassName}" Width="80"/>
                            <DataGridTextColumn Header="交通合適度" Binding="{Binding SuitabilityText}" Width="110"/>
                            <DataGridTextColumn Header="初步檢查" Binding="{Binding Status}" Width="190"/>
                            <DataGridTextColumn Header="備註" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="#1B2230" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CarDetailLabel" Text="尚未選取車輛（掃描後點選上方列表中的車輛）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="CarOverrideCheck" Content="啟用此車輛專屬行為覆寫" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#F3F5F7"/>
                                <TextBlock Text="侵略性" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="CarAggrSlider" Minimum="0" Maximum="1" Width="130" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=CarAggrSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="42"/>
                                <TextBlock Text="速度係數" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="CarSpeedSlider" Minimum="0.5" Maximum="1.5" Width="130" Value="1"/>
                                <TextBlock Text="{Binding ElementName=CarSpeedSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="42"/>
                                <TextBlock Text="變道頻率" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="CarLaneSlider" Minimum="0" Maximum="1" Width="130" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=CarLaneSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="42"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="套用覆寫" Click="ApplyCarOverride_Click" Width="90" Height="30" Background="#354153" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                <Button Content="清除覆寫" Click="ClearCarOverride_Click" Width="90" Height="30" Background="#354153" Foreground="White" BorderThickness="0" Margin="0,0,12,0"/>
                                <TextBlock Text="優先順序：個別車輛覆寫 ＞ 級別覆寫 ＞ 預設檔基礎行為 ＞ 全域預設" Foreground="#738093" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="地圖與 Layout">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TracksGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionChanged="TracksGrid_SelectionChanged"
                              Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                              AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="地圖資料夾" Binding="{Binding Folder}" Width="200"/>
                            <DataGridTextColumn Header="Layout" Binding="{Binding Layout}" Width="200"/>
                            <DataGridTextColumn Header="顯示名稱" Binding="{Binding DisplayName}" Width="240"/>
                            <DataGridTextColumn Header="類型" Binding="{Binding KindText}" Width="190"/>
                            <DataGridTextColumn Header="長度 km" Binding="{Binding LengthKm, StringFormat={}{0:F1}}" Width="90"/>
                            <DataGridTextColumn Header="AI 路線初檢" Binding="{Binding AiStatus}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="#1B2230" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TrackDetailLabel" Text="尚未選取地圖（掃描後點選上方列表中的地圖）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <TextBlock Text="軌道長度 (km，0 = 未知)" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                                <TextBox x:Name="TrackLengthBox" Width="80" Height="28" VerticalContentAlignment="Center"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6" Text="0"/>
                                <Button Content="儲存長度" Click="SaveTrackLength_Click" Width="90" Height="30" Margin="10,0,14,0" Background="#354153" Foreground="White" BorderThickness="0"/>
                                <TextBlock x:Name="TrackProfileHint" Foreground="#738093" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="交通預設檔">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="預設檔清單（雙擊或點選以編輯）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" Height="330"
                                 SelectionChanged="ProfilesList_SelectionChanged"
                                 Background="#171D26" Foreground="#F3F5F7" BorderBrush="#394352"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="新增自訂" Click="NewProfile_Click" Width="80" Height="30" Margin="0,0,6,6" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <Button Content="刪除" Click="DeleteProfile_Click" Width="60" Height="30" Margin="0,0,6,6" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <Button Content="重設內建" Click="ResetBuiltIns_Click" Width="80" Height="30" Margin="0,0,6,6" Background="#354153" Foreground="White" BorderThickness="0"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="匯出 JSON" Click="ExportProfile_Click" Width="90" Height="30" Margin="0,0,6,0" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <Button Content="匯入 JSON" Click="ImportProfile_Click" Width="90" Height="30" Background="#354153" Foreground="White" BorderThickness="0"/>
                        </WrapPanel>
                        <TextBlock Text="匯出為單一預設檔 JSON，方便分享或備份（寫入本程式資料夾或自選位置，不寫入遊戲）。"
                                   Foreground="#738093" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileEditor" Margin="6" IsEnabled="False">
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="名稱" Width="120" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <TextBox x:Name="ProfileNameBox" Width="260" Height="30" VerticalContentAlignment="Center"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6"/>
                                <TextBlock Text="類型" Width="60" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#AAB4C2"/>
                                <ComboBox x:Name="ProfileKindCombo" Width="150" Height="30">
                                    <ComboBoxItem Content="高速公路" Tag="Highway"/>
                                    <ComboBoxItem Content="賽道日" Tag="TrackDay"/>
                                    <ComboBoxItem Content="自訂" Tag="Custom"/>
                                </ComboBox>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="說明" Width="120" VerticalAlignment="Top" Foreground="#AAB4C2" Margin="0,6,0,0"/>
                                <TextBox x:Name="ProfileDescBox" Width="420" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6"/>
                            </WrapPanel>

                            <TextBlock Text="車流結構" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="最大 AI 車數（密度 100%）" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileMaxCarsSlider" Minimum="5" Maximum="120" Width="180" Value="40"/>
                                <TextBlock Text="{Binding ElementName=ProfileMaxCarsSlider, Path=Value, StringFormat={}{0:F0}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="車道數" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileLanesSlider" Minimum="1" Maximum="6" Width="180" Value="3"/>
                                <TextBlock Text="{Binding ElementName=ProfileLanesSlider, Path=Value, StringFormat={}{0:F0}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="速度係數最小值" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileMinSpeedSlider" Minimum="0.6" Maximum="1.4" Width="180" Value="0.9"/>
                                <TextBlock Text="{Binding ElementName=ProfileMinSpeedSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="速度係數最大值" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileMaxSpeedSlider" Minimum="0.6" Maximum="1.4" Width="180" Value="1.1"/>
                                <TextBlock Text="{Binding ElementName=ProfileMaxSpeedSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="生成距離最小 (m)" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileSpawnMinSlider" Minimum="100" Maximum="2000" Width="180" Value="400"/>
                                <TextBlock Text="{Binding ElementName=ProfileSpawnMinSlider, Path=Value, StringFormat={}{0:F0}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="生成距離最大 (m)" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileSpawnMaxSlider" Minimum="100" Maximum="2000" Width="180" Value="1500"/>
                                <TextBlock Text="{Binding ElementName=ProfileSpawnMaxSlider, Path=Value, StringFormat={}{0:F0}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="地圖長度估計 (km)" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileLengthSlider" Minimum="1" Maximum="80" Width="180" Value="20"/>
                                <TextBlock Text="{Binding ElementName=ProfileLengthSlider, Path=Value, StringFormat={}{0:F1}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="允許標籤（空白=全部）" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <TextBox x:Name="AllowedTagsBox" Width="180" Height="30" VerticalContentAlignment="Center"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6"/>
                                <TextBlock Text="排除標籤" Width="70" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AAB4C2"/>
                                <TextBox x:Name="ExcludedTagsBox" Width="160" Height="30" VerticalContentAlignment="Center"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6" Text="formula"/>
                            </WrapPanel>

                            <TextBlock Text="基礎 AI 行為（此預設檔）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="侵略性" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileAggrSlider" Minimum="0" Maximum="1" Width="180" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=ProfileAggrSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="速度係數" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileSpeedSlider" Minimum="0.5" Maximum="1.5" Width="180" Value="1"/>
                                <TextBlock Text="{Binding ElementName=ProfileSpeedSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="變道頻率" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileLaneSlider" Minimum="0" Maximum="1" Width="180" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=ProfileLaneSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="跟車距離係數" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileFollowSlider" Minimum="0.3" Maximum="3" Width="180" Value="1"/>
                                <TextBlock Text="{Binding ElementName=ProfileFollowSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="超車傾向" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileOvertakeSlider" Minimum="0" Maximum="1" Width="180" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=ProfileOvertakeSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="圍觀機率" Width="200" VerticalAlignment="Center" Foreground="#AAB4C2"/>
                                <Slider x:Name="ProfileRubberSlider" Minimum="0" Maximum="1" Width="180" Value="0.05"/>
                                <TextBlock Text="{Binding ElementName=ProfileRubberSlider, Path=Value, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <WrapPanel>
                                <Button Content="儲存預設檔" Click="SaveProfile_Click" Width="110" Height="34" Background="#36C58A" Foreground="#102018" FontWeight="Bold" BorderThickness="0"/>
                                <TextBlock Text="儲存到本機 profiles.json（%AppData%\ACLocalTrafficStudio），不寫入遊戲資料夾。" Foreground="#738093" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="AI 行為管理">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1B2230" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="全域預設 AI 行為（建立新預設檔時套用；解析優先順序最低的一層）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="侵略性" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalAggrSlider" Minimum="0" Maximum="1" Width="110" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=GlobalAggrSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="速度係數" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalSpeedSlider" Minimum="0.5" Maximum="1.5" Width="110" Value="1"/>
                                <TextBlock Text="{Binding ElementName=GlobalSpeedSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="變道頻率" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalLaneSlider" Minimum="0" Maximum="1" Width="110" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=GlobalLaneSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="跟車距離" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalFollowSlider" Minimum="0.3" Maximum="3" Width="110" Value="1"/>
                                <TextBlock Text="{Binding ElementName=GlobalFollowSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="超車傾向" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalOvertakeSlider" Minimum="0" Maximum="1" Width="110" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=GlobalOvertakeSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="圍觀機率" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="GlobalRubberSlider" Minimum="0" Maximum="1" Width="110" Value="0.05"/>
                                <TextBlock Text="{Binding ElementName=GlobalRubberSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="儲存全域預設" Click="SaveGlobal_Click" Width="110" Height="30" Background="#354153" Foreground="White" BorderThickness="0"/>
                                <TextBlock Text="優先順序：個別車輛 ＞ 級別（下方表格）＞ 預設檔基礎行為 ＞ 全域預設" Foreground="#738093" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ClassGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionChanged="ClassGrid_SelectionChanged"
                                  Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                                  AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="車輛級別 (class)" Binding="{Binding ClassName}" Width="220"/>
                                <DataGridTextColumn Header="侵略性覆寫" Binding="{Binding Aggression}" Width="130"/>
                                <DataGridTextColumn Header="速度係數覆寫" Binding="{Binding SpeedMultiplier}" Width="130"/>
                                <DataGridTextColumn Header="變道頻率覆寫" Binding="{Binding LaneChangeFrequency}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#1B2230" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                            <WrapPanel>
                                <TextBlock Text="級別名稱" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                                <TextBox x:Name="ClassNameBox" Width="150" Height="28" VerticalContentAlignment="Center"
                                         Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6"/>
                                <TextBlock Text="侵略性" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="ClassAggrSlider" Minimum="0" Maximum="1" Width="100" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=ClassAggrSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="速度係數" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="ClassSpeedSlider" Minimum="0.5" Maximum="1.5" Width="100" Value="1"/>
                                <TextBlock Text="{Binding ElementName=ClassSpeedSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <TextBlock Text="變道頻率" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                                <Slider x:Name="ClassLaneSlider" Minimum="0" Maximum="1" Width="100" Value="0.5"/>
                                <TextBlock Text="{Binding ElementName=ClassLaneSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="38"/>
                                <Button Content="套用級別覆寫" Click="SaveClassOverride_Click" Width="100" Height="30" Margin="14,0,6,0" Background="#354153" Foreground="White" BorderThickness="0"/>
                                <Button Content="清除" Click="ClearClassOverride_Click" Width="60" Height="30" Background="#354153" Foreground="White" BorderThickness="0"/>
                            </WrapPanel>
                            <TextBlock Text="級別覆寫套用於「作用中的預設檔」；掃描後此處會列出所有出現過的車輛級別。" Foreground="#738093" Margin="0,8,0,0"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="密度控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="動態交通密度調節" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="密度 0–100；實際 AI 車數 = 預設檔最大車數 × 密度 ÷ 100。可立即套用，或平滑過渡（模擬實際運行時的漸變行為）。"
                                   Foreground="#AAB4C2" TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="目標密度" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAB4C2"/>
                            <Slider x:Name="DensitySlider" Minimum="0" Maximum="100" Width="280" Value="50" ValueChanged="DensitySlider_ValueChanged"/>
                            <TextBlock Text="{Binding ElementName=DensitySlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" Width="40"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAB4C2"/>
                            <ComboBox x:Name="DensityModeCombo" Width="150" Height="28" SelectionChanged="DensityModeCombo_SelectionChanged">
                                <ComboBoxItem Content="立即套用" Tag="Immediate"/>
                                <ComboBoxItem Content="平滑過渡" Tag="Smooth"/>
                            </ComboBox>
                            <TextBlock Text="過渡速度（密度/秒）" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#AAB4C2"/>
                            <Slider x:Name="RampSlider" Minimum="0.5" Maximum="10" Width="150" Value="2" ValueChanged="RampSlider_ValueChanged"/>
                            <TextBlock Text="{Binding ElementName=RampSlider, Path=Value, StringFormat={}{0:F1}}" VerticalAlignment="Center" Width="40"/>
                        </WrapPanel>
                        <TextBlock x:Name="DensityStatusText" Text="目前密度：50 / 100 ｜ 目標：50 ｜ AI 車數：—" Margin="0,4,0,6"/>
                        <ProgressBar x:Name="DensityBar" Minimum="0" Maximum="100" Height="16" Value="50"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="SimStartButton" Content="開始模擬" Click="SimStart_Click" Width="90" Height="30" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="SimStopButton" Content="停止模擬" Click="SimStop_Click" Width="90" Height="30" Margin="8,0,0,0" IsEnabled="False" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="模擬會以 0.5 秒間隔推進密度控制器，觀察目前密度如何漸進接近目標。" Foreground="#738093" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </WrapPanel>

                        <TextBlock Text="密度排程（動態調節預案）" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <WrapPanel>
                            <ComboBox x:Name="ScheduleCombo" Width="190" Height="28">
                                <ComboBoxItem Content="恒定" Tag="constant"/>
                                <ComboBoxItem Content="尖峰時段車流" Tag="rush_hour"/>
                                <ComboBoxItem Content="深夜稀疏" Tag="night"/>
                                <ComboBoxItem Content="賽道日漸進加密" Tag="trackday_ramp"/>
                            </ComboBox>
                            <TextBlock Text="時長（秒）" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAB4C2"/>
                            <TextBox x:Name="ScheduleDurationBox" Width="70" Height="28" VerticalContentAlignment="Center"
                                     Background="#111720" Foreground="White" BorderBrush="#465263" Padding="6" Text="1800"/>
                            <Button Content="產生排程" Click="GenerateSchedule_Click" Width="90" Height="30" Margin="10,0,6,0" Background="#354153" Foreground="White" BorderThickness="0"/>
                            <Button Content="套用排程到模擬" Click="ApplySchedule_Click" Width="130" Height="30" Background="#354153" Foreground="White" BorderThickness="0"/>
                        </WrapPanel>
                        <TextBox x:Name="ScheduleBox" IsReadOnly="True" AcceptsReturn="True" Height="130" Margin="0,10,0,0"
                                 Background="#171D26" Foreground="#DCE4ED" BorderBrush="#394352" Padding="10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="交通計畫">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="地圖/Layout" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB4C2"/>
                        <ComboBox x:Name="PlanTrackCombo" Width="270" Height="28" DisplayMemberPath="DisplayName" SelectionChanged="PlanTrackCombo_SelectionChanged"/>
                        <TextBlock Text="預設檔" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#AAB4C2"/>
                        <ComboBox x:Name="PlanProfileCombo" Width="200" Height="28" DisplayMemberPath="Name"/>
                        <TextBlock Text="密度" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#AAB4C2"/>
                        <Slider x:Name="PlanDensitySlider" Minimum="0" Maximum="100" Width="140" Value="50"/>
                        <TextBlock Text="{Binding ElementName=PlanDensitySlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" Width="36"/>
                        <Button Content="產生計畫" Click="GeneratePlan_Click" Width="90" Height="30" Margin="14,0,0,0" Background="#36C58A" Foreground="#102018" FontWeight="Bold" BorderThickness="0"/>
                    </WrapPanel>
                    <TextBlock x:Name="PlanSummary" Grid.Row="1" Margin="0,10,0,6" Foreground="#DCE4ED" TextWrapping="Wrap"/>
                    <DataGrid x:Name="PlanGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="#202631" Foreground="#F3F5F7" RowBackground="#202631"
                              AlternatingRowBackground="#252E3A" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#394352" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="車輛" Binding="{Binding DisplayName}" Width="220"/>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="120"/>
                            <DataGridTextColumn Header="生成位置 m" Binding="{Binding SpawnDistanceM, StringFormat={}{0:F0}}" Width="120"/>
                            <DataGridTextColumn Header="車道" Binding="{Binding Lane}" Width="60"/>
                            <DataGridTextColumn Header="速度係數" Binding="{Binding SpeedMultiplier, StringFormat={}{0:F2}}" Width="90"/>
                            <DataGridTextColumn Header="侵略性" Binding="{Binding Behavior.Aggression, StringFormat={}{0:F2}}" Width="90"/>
                            <DataGridTextColumn Header="超車傾向" Binding="{Binding Behavior.OvertakeBias, StringFormat={}{0:F2}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PlanWarnings" Grid.Row="3" Foreground="#E0A473" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <WrapPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button Content="匯出計畫 JSON" Click="ExportPlan_Click" Width="140" Height="32" Background="#354153" Foreground="White" BorderThickness="0"/>
                        <Button Content="匯出摘要 MD" Click="ExportSummary_Click" Width="120" Height="32" Margin="8,0,0,0" Background="#354153" Foreground="White" BorderThickness="0"/>
                        <TextBlock Text="匯出為唯讀檔案至本程式匯出資料夾（%AppData%\ACLocalTrafficStudio\exports），不會修改任何遊戲檔案。"
                                   Foreground="#738093" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Width="520"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="掃描報告">
                <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="#202631" Foreground="#DCE4ED"
                         BorderThickness="0" Padding="14"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="準備就緒。本程式完全離線、唯讀，不會修改遊戲檔案。" Foreground="#AAB4C2" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="V2.0.0 · Phase 2 · OFFLINE" Foreground="#738093"/>
        </DockPanel>
    </Grid>
</Window>
